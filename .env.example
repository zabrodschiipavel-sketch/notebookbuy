# Copy to .env and fill in your key:  cp .env.example .env

# Required for AI spec extraction and world-price lookups (optional if regex is enough)
GEMINI_API_KEY=

# Model (default: gemini-3.1-flash-lite-preview)
# GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Stronger model that reviews the digest top before sending (default: gemini-pro-latest).
# NOTE: pro models need a billing-enabled key; on the free tier the review
# walks down the comma-separated fallback chain instead.
# GEMINI_PRO_MODEL=gemini-pro-latest
# GEMINI_REVIEW_FALLBACK_MODEL=gemini-flash-latest,gemini-2.5-flash

# AI review of the Telegram digest top (catches scams and parsing garbage)
# ENABLE_AI_REVIEW=true
# AI_REVIEW_TOP_N=15

# AI rate limits (reduce if you hit 429 errors)
# Requests per minute allowed PER MODEL. Gemini's free tier grants 15 RPM;
# the client throttles to this value instead of firing until it gets 429s.
# GEMINI_RPM_LIMIT=12
# GEMINI_MAX_WORKERS=3
# GEMINI_REQUEST_DELAY_SEC=0.5
# GEMINI_SEARCH_DELAY_SEC=1.5
# GEMINI_MAX_RETRIES=3
# Cap on a single back-off, including the delay the API itself asks for.
# GEMINI_MAX_BACKOFF_SEC=65

# Skip slow Google Search lookups for world prices / Notebookcheck (faster runs)
# ENABLE_EXTERNAL_LOOKUPS=true
# How long a failed world-price / Notebookcheck lookup is remembered, so the
# same fruitless query does not burn quota on every run (days).
# EXTERNAL_MISS_TTL_DAYS=7

# Analyzer filters (override defaults from scoring.py)
# MIN_CPU_SCORE=2500
# ADS_ANALYZE_LIMIT=500

# Database file name (default: laptops_database.db)
# DB_NAME=laptops_database.db

# Passmark benchmark cache lifetime in days (default: 7)
# PASSMARK_CACHE_DAYS=7

# Telegram digest (send_telegram.py) — both required to send notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
