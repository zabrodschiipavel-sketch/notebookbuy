# Copy to .env and fill in your key:  cp .env.example .env

# AI: spec extraction, reading prices out of search results, digest review.
# All of it goes through OpenRouter. Optional — without a key the regex parser
# still works, but ads it cannot parse drop out and the digest is unreviewed.
# Account settings the defaults depend on (https://openrouter.ai/settings):
#  - privacy: allow endpoints that may train on prompts — free models and
#    Muse Spark Contributor do, and are refused with a 404 otherwise;
#  - credits: Muse Spark Contributor is paid (cents a month here) and needs a
#    positive balance. Buying $10 once also lifts the free-model cap from
#    50 to 1000 requests a day.
OPENROUTER_API_KEY=

# Primary model: must be free AND support structured outputs.
# `python openrouter.py` lists the current candidates.
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Comma-separated, tried in order within the same request when the one before
# errors, is rate-limited or gone. `openrouter/free` (a router over whatever is
# free right now) makes a last-resort third entry.
# OPENROUTER_FALLBACK_MODELS=meta/muse-spark-1.3-contributor
# The digest review runs once a day and deletes listings it rejects; point it
# at a stronger model if you like. Defaults to OPENROUTER_MODEL.
# OPENROUTER_REVIEW_MODEL=

# AI review of the Telegram digest top (catches scams and parsing garbage)
# ENABLE_AI_REVIEW=true
# AI_REVIEW_TOP_N=15

# Repeat handling: a listing already shown at an unchanged price is held back
# for this many days. A price change makes it eligible again immediately.
# DIGEST_REPEAT_COOLDOWN_DAYS=7
# Held-back listings come back if the digest would otherwise be thinner.
# DIGEST_MIN_DEALS=3

# Second, city-specific section; rendered only when it has something in it.
# DIGEST_REGION=Бельцы

# "Got cheaper" block. Bounds keep out typo corrections (a 99% "drop" is a
# seller fixing a 111111 MDL price, not a bargain).
# DIGEST_PRICE_DROPS_N=3
# PRICE_DROP_MIN_PCT=10
# PRICE_DROP_MAX_PCT=70

# AI throughput. OpenRouter allows 20 requests/minute on :free models and
# 50 requests/day (1000/day after $10 of credits). Ads are extracted in
# batches, so a morning run needs ~10-30 requests in total.
# AI_EXTRACT_BATCH_SIZE=10
# AI_MAX_WORKERS=2
# AI_RPM_LIMIT=16
# AI_MAX_RETRIES=3
# AI_RETRY_DELAY_SEC=2
# AI_SEARCH_DELAY_SEC=1.5
# Cap on a single back-off, including the delay the API itself asks for.
# AI_MAX_BACKOFF_SEC=65
# AI_TIMEOUT_SEC=120
# Most unparsed ads sent to the AI per run (newest first; the rest wait for the
# next run). Keeps extraction from spending the quota the review needs.
# AI_EXTRACT_MAX_ADS=200

# Brave Search — grounds world-price and Notebookcheck lookups in real search
# results instead of asking the model to recall a price. Without it those
# numbers fall back to the component formula (marked ≈ in the digest).
# Free tier: 1 request/second, 2000 requests/month.
BRAVE_API_KEY=
# BRAVE_RESULTS=5
# BRAVE_TIMEOUT_SEC=20

# Skip slow web lookups for world prices / Notebookcheck (faster runs)
# ENABLE_EXTERNAL_LOOKUPS=true
# How long a failed world-price / Notebookcheck lookup is remembered, so the
# same fruitless query does not burn quota on every run (days).
# EXTERNAL_MISS_TTL_DAYS=7

# Scraper: pages through the whole 999.md category.
# SCRAPE_PAGE_SIZE=200
# SCRAPE_MAX_ADS=5000
# SCRAPE_PAGE_DELAY_SEC=1.5

# Analyzer filters (override defaults from scoring.py)
# MIN_CPU_SCORE=2500
# ADS_ANALYZE_LIMIT=5000   # defaults to SCRAPE_MAX_ADS

# Database file name (default: laptops_database.db)
# DB_NAME=laptops_database.db

# Passmark benchmark cache lifetime in days (default: 7)
# PASSMARK_CACHE_DAYS=7

# Telegram digest (send_telegram.py) — both required to send notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
